# Copy to .env.local and fill in. Nothing here is required to run the store locally:
# without M-Pesa keys, checkout falls back to confirming the order on WhatsApp.

# Public site origin (used for canonical URLs, sitemap and the M-Pesa callback)
NEXT_PUBLIC_SITE_URL=https://store.steffcloud.co.ke

# Safaricom Daraja — Lipa na M-Pesa Online (STK Push)
MPESA_ENV=sandbox            # sandbox | production
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=             # Paybill or Till (Buy Goods) number
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline   # or CustomerBuyGoodsOnline for a Till

# Analytics (load only after cookie consent)
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_TIKTOK_PIXEL_ID=

# Optional overrides
MPESA_PARTY_B=               # Till number when using Buy Goods (defaults to MPESA_SHORTCODE)
MPESA_CALLBACK_URL=          # defaults to NEXT_PUBLIC_SITE_URL + /api/mpesa/callback (must be https)

# Where new orders and M-Pesa results are POSTed as JSON until a database is connected
# (Google Apps Script web app → Google Sheet, Make, Zapier, n8n, Slack/Discord incoming webhook…)
ORDER_WEBHOOK_URL=
